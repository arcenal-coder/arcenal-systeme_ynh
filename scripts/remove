#!/bin/bash

source /usr/share/yunohost/helpers

ynh_script_progression "Restauration du catalogue précédent..."
catalogue_sauvegarde="/etc/yunohost/apps/${app}"
if test -f "$catalogue_sauvegarde/catalogue-pre-arcenal.yml"; then
    cp --preserve=mode,timestamps "$catalogue_sauvegarde/catalogue-pre-arcenal.yml" /etc/yunohost/apps_catalog.yml
else
    rm -f /etc/yunohost/apps_catalog.yml
fi
yunohost tools update apps
